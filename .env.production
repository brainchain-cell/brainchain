# Loaded by `next build`, including the Cloudflare Pages build.
# Keeps https://brainchainlab.com indexable. A Pages environment variable overrides this file.
# Set NEXT_PUBLIC_SITE_INDEXABLE=false only for a private noindex build.
# Do not put NEXT_PUBLIC_CF_BEACON_TOKEN here. It stays a Pages environment variable.
NEXT_PUBLIC_SITE_INDEXABLE=true
