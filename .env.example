# Cloudflare Web Analytics site token (cookieless beacon).
# Leave unset and the site renders no analytics script.
# Set this in Cloudflare Pages → Settings → Environment variables, then redeploy.
# The value is inlined at build time because the site is a static export.
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# Private reviews stay noindex by default. Set true ONLY for the public production build.
# NEXT_PUBLIC_SITE_INDEXABLE=true
